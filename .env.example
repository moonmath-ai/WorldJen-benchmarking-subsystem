# Copy this file to .env and fill in your API keys.
# Never commit .env to git.

# ── Required for prompt pipeline (Stage 1) and VLM evaluation (Stage 3) ───
GEMINI_API_KEY=your_gemini_api_key_here

# ── Required for A4 cross-VLM ablation (Claude Sonnet 4.6) ────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── Required to download dataset from HuggingFace (Stage 0) ───────────────
HF_TOKEN=your_huggingface_token_here

# ── Optional: where the downloaded dataset lives (default: ./data) ─────────
# WORLDJEN_DATA_ROOT=/path/to/your/data

# ── Optional: path to a local Gemma 4 31B model (Stage A6 only) ────────────
# Default: /data/models/gemma-4-31b-it
# GEMMA4_MODEL_PATH=/path/to/gemma-4-31b-it

# ── Optional: path to the cloned VBench repository (Stage 4) ───────────────
# Set this to the root of a `git clone https://github.com/Vchitect/VBench`
# VBENCH_DIR=/path/to/VBench
